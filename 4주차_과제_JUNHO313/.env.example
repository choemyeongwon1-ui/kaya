# ④ 환경변수 — 이 파일을 .env 로 복사해서 값을 채운다. .env 는 저장소에 올리지 않는다(.gitignore).
# 값 위치: Supabase 대시보드 > Project Settings > API Keys / Data API

SUPABASE_URL=https://<프로젝트ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# (선택) check_supabase.py 의 팀원 쓰기 테스트용 — Supabase Auth 에 만든 팀원 계정
SUPABASE_TEST_EMAIL=
SUPABASE_TEST_PASSWORD=

# 여기에 넣지 말 것: sb_secret_... (비밀 키), service_role 키, DB 비밀번호
